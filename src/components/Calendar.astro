---
import { getCollection } from 'astro:content';
import type { ScheduleEntry } from '../lib/schedule';
import { parseSolarDate } from '../lib/schedule';
import Calendar from './Calendar';

const entries = await getCollection('schedule');
const fmtDate = (d: Date): string => `${String(d.getDate()).padStart(2, '0')}-${String(d.getMonth() + 1).padStart(2, '0')}-${d.getFullYear()}`;
const schedules: ScheduleEntry[] = entries.map((e) => {
  const { date, ...rest } = e.data;
  return { ...rest, ...(date instanceof Date ? { date: fmtDate(date) } : date ? { date } : {}) };
});

const viewParam = Astro.url.searchParams.get('view');
const initialView = viewParam === 'month' || viewParam === 'year' ? viewParam : undefined;
const parsed = parseSolarDate(Astro.url.searchParams.get('date') ?? undefined);
const initialDate = parsed ? new Date(parsed.y, parsed.m - 1, parsed.d) : undefined;
---

<Calendar schedules={schedules} initialDate={initialDate} initialView={initialView} client:load />